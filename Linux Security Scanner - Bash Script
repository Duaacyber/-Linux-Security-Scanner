#=========================================
# COLOR DEFINITIONS
#=========================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m' # No Color
BOLD='\033[1m'

#=========================================
# GLOBAL VARIABLES
#=========================================
VERSION="1.0.0"
REPORT_FILE=""
LOG_FILE="/tmp/security_scanner.log"
ISSUES_FOUND=0
WARNINGS_FOUND=0
PASSED_CHECKS=0
TOTAL_CHECKS=0
SCAN_START_TIME=""
SCAN_END_TIME=""

#=========================================
# INITIALIZATION
#=========================================
init_scanner() {
    SCAN_START_TIME=$(date +"%Y-%m-%d %H:%M:%S")
    REPORT_FILE="security_report_$(date +%Y%m%d_%H%M%S).txt"
    
    # Check if running as root
    if [[ $EUID -ne 0 ]]; then
        echo -e "${YELLOW}[WARNING] Some checks require root privileges${NC}"
        echo -e "${YELLOW}[WARNING] Run with 'sudo' for complete scan${NC}"
        echo ""
    fi

    # Create log file
    touch "$LOG_FILE" 2>/dev/null

    echo -e "${CYAN}========================================${NC}"
    echo -e "${CYAN}   LINUX SECURITY SCANNER v$VERSION   ${NC}"
    echo -e "${CYAN}========================================${NC}"
    echo -e "${WHITE}Scan Started: $SCAN_START_TIME${NC}"
    echo -e "${WHITE}Report File: $REPORT_FILE${NC}"
    echo ""
}

#=========================================
# LOGGING FUNCTIONS
#=========================================
log_info() {
    local message="$1"
    echo -e "${BLUE}[INFO]${NC} $message" | tee -a "$LOG_FILE"
    echo "[INFO] $message" >> "$REPORT_FILE" 2>/dev/null
}

log_pass() {
    local message="$1"
    ((PASSED_CHECKS++))
    ((TOTAL_CHECKS++))
    echo -e "${GREEN}[PASS]${NC} $message" | tee -a "$LOG_FILE"
    echo "[PASS] $message" >> "$REPORT_FILE" 2>/dev/null
}

log_warn() {
    local message="$1"
    ((WARNINGS_FOUND++))
    ((TOTAL_CHECKS++))
    echo -e "${YELLOW}[WARN]${NC} $message" | tee -a "$LOG_FILE"
    echo "[WARN] $message" >> "$REPORT_FILE" 2>/dev/null
}

log_fail() {
    local message="$1"
    ((ISSUES_FOUND++))
    ((TOTAL_CHECKS++))
    echo -e "${RED}[FAIL]${NC} $message" | tee -a "$LOG_FILE"
    echo "[FAIL] $message" >> "$REPORT_FILE" 2>/dev/null
}

#=========================================
# CHECK 1: USER ACCOUNT SECURITY
#=========================================
check_user_accounts() {
    echo -e "\n${BOLD}${MAGENTA}=== CHECKING USER ACCOUNTS ===${NC}"
    echo "=== USER ACCOUNT CHECKS ===" >> "$REPORT_FILE"

    # Check for accounts with empty passwords
    log_info "Checking for empty passwords..."
    EMPTY_PASS=$(awk -F: '($2 == "" ) {print $1}' /etc/shadow 2>/dev/null)
    if [[ -z "$EMPTY_PASS" ]]; then
        log_pass "No accounts with empty passwords found"
    else
        log_fail "Accounts with empty passwords: $EMPTY_PASS"
    fi

    # Check for accounts with UID 0
    log_info "Checking for accounts with UID 0..."
    UID_ZERO=$(awk -F: '($3 == 0) {print $1}' /etc/passwd)
    UID_COUNT=$(echo "$UID_ZERO" | wc -l)
    if [[ "$UID_COUNT" -eq 1 ]]; then
        log_pass "Only root has UID 0"
    else
        log_fail "Multiple accounts with UID 0: $UID_ZERO"
    fi

    # Check for unlocked accounts without password
    log_info "Checking for unlocked accounts..."
    UNLOCKED=$(awk -F: '($2 != "*" && $2 != "!" && $2 != "!!") {print $1}' /etc/shadow 2>/dev/null)
    if [[ -n "$UNLOCKED" ]]; then
        log_warn "Unlocked accounts found: $UNLOCKED"
    else
        log_pass "All non-user accounts are locked"
    fi

    # Check for users with shell access
    log_info "Checking users with shell access..."
    SHELL_USERS=$(awk -F: '($7 != "/usr/sbin/nologin" && $7 != "/bin/false" && $7 != "/sbin/nologin") {print $1": "$7}' /etc/passwd)
    log_info "Users with shell access: $SHELL_USERS"
}

#=========================================
# CHECK 2: PASSWORD POLICY
#=========================================
check_password_policy() {
    echo -e "\n${BOLD}${MAGENTA}=== CHECKING PASSWORD POLICY ===${NC}"
    echo "=== PASSWORD POLICY CHECKS ===" >> "$REPORT_FILE"

    # Check minimum password length
    log_info "Checking minimum password length..."
    if [[ -f /etc/login.defs ]]; then
        PASS_MIN_LEN=$(grep "^PASS_MIN_LEN" /etc/login.defs | awk '{print $2}')
        if [[ -z "$PASS_MIN_LEN" ]]; then
            PASS_MIN_LEN=5
        fi
        if [[ "$PASS_MIN_LEN" -ge 12 ]]; then
            log_pass "Minimum password length is $PASS_MIN_LEN (>=12)"
        elif [[ "$PASS_MIN_LEN" -ge 8 ]]; then
            log_warn "Minimum password length is $PASS_MIN_LEN (recommended: 12+)"
        else
            log_fail "Minimum password length is only $PASS_MIN_LEN (too short!)"
        fi
    else
        log_warn "/etc/login.defs not found"
    fi

    # Check password max days
    log_info "Checking password maximum age..."
    PASS_MAX_DAYS=$(grep "^PASS_MAX_DAYS" /etc/login.defs | awk '{print $2}')
    if [[ -n "$PASS_MAX_DAYS" ]]; then
        if [[ "$PASS_MAX_DAYS" -le 90 ]]; then
            log_pass "Password max age is $PASS_MAX_DAYS days"
        elif [[ "$PASS_MAX_DAYS" -le 180 ]]; then
            log_warn "Password max age is $PASS_MAX_DAYS days (recommended: 90)"
        else
            log_fail "Password max age is $PASS_MAX_DAYS days (too long!)"
        fi
    fi

    # Check password complexity with pam_cracklib/pam_pwquality
    log_info "Checking password complexity module..."
    if [[ -f /etc/pam.d/system-auth ]]; then
        if grep -q "pam_pwquality\|pam_cracklib" /etc/pam.d/system-auth 2>/dev/null; then
            log_pass "Password complexity module is enabled"
        else
            log_fail "Password complexity module not found"
        fi
    elif [[ -f /etc/pam.d/common-password ]]; then
        if grep -q "pam_pwquality\|pam_cracklib" /etc/pam.d/common-password 2>/dev/null; then
            log_pass "Password complexity module is enabled"
        else
            log_fail "Password complexity module not found"
        fi
    fi
}

#=========================================
# CHECK 3: SSH CONFIGURATION
#=========================================
check_ssh_config() {
    echo -e "\n${BOLD}${MAGENTA}=== CHECKING SSH CONFIGURATION ===${NC}"
    echo "=== SSH CONFIGURATION CHECKS ===" >> "$REPORT_FILE"

    SSH_CONFIG="/etc/ssh/sshd_config"

    if [[ ! -f "$SSH_CONFIG" ]]; then
        log_warn "SSH configuration file not found"
        return
    fi

    # Check root login
    log_info "Checking SSH root login..."
    ROOT_LOGIN=$(grep -i "^PermitRootLogin" "$SSH_CONFIG" | awk '{print $2}')
    if [[ "$ROOT_LOGIN" == "no" ]]; then
        log_pass "Root login via SSH is disabled"
    elif [[ "$ROOT_LOGIN" == "prohibit-password" ]] || [[ "$ROOT_LOGIN" == "without-password" ]]; then
        log_warn "Root login allowed with key-based auth only"
    else
        log_fail "Root login via SSH is enabled!"
    fi

    # Check password authentication
    log_info "Checking SSH password authentication..."
    PASS_AUTH=$(grep -i "^PasswordAuthentication" "$SSH_CONFIG" | awk '{print $2}')
    if [[ "$PASS_AUTH" == "no" ]]; then
        log_pass "Password authentication is disabled"
    else
        log_warn "Password authentication is enabled (key-based recommended)"
    fi

    # Check for empty passwords in SSH
    log_info "Checking SSH empty passwords..."
    EMPTY_PASS_SSH=$(grep -i "^PermitEmptyPasswords" "$SSH_CONFIG" | awk '{print $2}')
    if [[ "$EMPTY_PASS_SSH" == "no" ]]; then
        log_pass "Empty passwords are disabled in SSH"
    else
        log_fail "Empty passwords may be allowed in SSH!"
    fi

    # Check SSH protocol version
    log_info "Checking SSH protocol..."
    PROTOCOL=$(grep -i "^Protocol" "$SSH_CONFIG" | awk '{print $2}')
    if [[ -z "$PROTOCOL" ]] || [[ "$PROTOCOL" == "2" ]]; then
        log_pass "Using SSH Protocol 2 (secure)"
    else
        log_fail "Using old SSH Protocol 1 (insecure!)"
    fi

    # Check MaxAuthTries
    log_info "Checking SSH max auth tries..."
    MAX_AUTH=$(grep -i "^MaxAuthTries" "$SSH_CONFIG" | awk '{print $2}')
    if [[ -n "$MAX_AUTH" ]] && [[ "$MAX_AUTH" -le 4 ]]; then
        log_pass "MaxAuthTries is set to $MAX_AUTH"
    elif [[ -n "$MAX_AUTH" ]]; then
        log_warn "MaxAuthTries is $MAX_AUTH (recommended: 4 or less)"
    else
        log_warn "MaxAuthTries not configured (default: 6)"
    fi
}

#=========================================
# CHECK 4: FIREWALL STATUS
#=========================================
check_firewall() {
    echo -e "\n${BOLD}${MAGENTA}=== CHECKING FIREWALL STATUS ===${NC}"
    echo "=== FIREWALL CHECKS ===" >> "$REPORT_FILE"

    FIREWALL_ACTIVE=false

    # Check UFW
    log_info "Checking UFW status..."
    if command -v ufw &> /dev/null; then
        UFW_STATUS=$(ufw status | grep "Status:" | awk '{print $2}')
        if [[ "$UFW_STATUS" == "active" ]]; then
            log_pass "UFW firewall is active"
            FIREWALL_ACTIVE=true
        else
            log_warn "UFW is installed but not active"
        fi
    fi

    # Check firewalld
    log_info "Checking firewalld status..."
    if command -v firewall-cmd &> /dev/null; then
        FW_STATUS=$(firewall-cmd --state 2>/dev/null)
        if [[ "$FW_STATUS" == "running" ]]; then
            log_pass "firewalld is running"
            FIREWALL_ACTIVE=true
        else
            log_warn "firewalld is installed but not running"
        fi
    fi

    # Check iptables
    log_info "Checking iptables rules..."
    if command -v iptables &> /dev/null; then
        IPT_RULES=$(iptables -L -n 2>/dev/null | wc -l)
        if [[ "$IPT_RULES" -gt 5 ]]; then
            log_pass "iptables has $IPT_RULES rules configured"
            FIREWALL_ACTIVE=true
        else
            log_warn "iptables has minimal rules"
        fi
    fi

    if [[ "$FIREWALL_ACTIVE" == false ]]; then
        log_fail "No active firewall detected!"
    fi
}

#=========================================
# CHECK 5: OPEN PORTS
#=========================================
check_open_ports() {
    echo -e "\n${BOLD}${MAGENTA}=== CHECKING OPEN PORTS ===${NC}"
    echo "=== OPEN PORT CHECKS ===" >> "$REPORT_FILE"

    log_info "Scanning open ports..."

    if command -v ss &> /dev/null; then
        OPEN_PORTS=$(ss -tlnp 2>/dev/null | grep LISTEN)
        echo -e "${CYAN}Open TCP Ports:${NC}"
        echo "$OPEN_PORTS" | tee -a "$LOG_FILE"
        echo "$OPEN_PORTS" >> "$REPORT_FILE"

        # Check for dangerous ports
        DANGEROUS_PORTS=$(echo "$OPEN_PORTS" | grep -E ":23 |:21 |:445 |:3389 " | head -5)
        if [[ -n "$DANGEROUS_PORTS" ]]; then
            log_warn "Potentially dangerous ports open (Telnet/FTP/SMB/RDP)"
        else
            log_pass "No common dangerous ports detected"
        fi
    elif command -v netstat &> /dev/null; then
        netstat -tlnp 2>/dev/null | tee -a "$LOG_FILE"
    else
        log_warn "Neither ss nor netstat available"
    fi
}

#=========================================
# CHECK 6: SUID/SGID FILES
#=========================================
check_suid_sgid() {
    echo -e "\n${BOLD}${MAGENTA}=== CHECKING SUID/SGID FILES ===${NC}"
    echo "=== SUID/SGID CHECKS ===" >> "$REPORT_FILE"

    log_info "Searching for SUID files..."
    SUID_FILES=$(find / -perm -4000 -type f 2>/dev/null | head -20)
    SUID_COUNT=$(find / -perm -4000 -type f 2>/dev/null | wc -l)

    if [[ "$SUID_COUNT" -eq 0 ]]; then
        log_pass "No SUID files found"
    else
        log_warn "Found $SUID_COUNT SUID files (review recommended)"
        echo "$SUID_FILES" | head -10 | tee -a "$LOG_FILE"
    fi

    log_info "Searching for SGID files..."
    SGID_FILES=$(find / -perm -2000 -type f 2>/dev/null | head -20)
    SGID_COUNT=$(find / -perm -2000 -type f 2>/dev/null | wc -l)

    if [[ "$SGID_COUNT" -eq 0 ]]; then
        log_pass "No SGID files found"
    else
        log_warn "Found $SGID_COUNT SGID files (review recommended)"
        echo "$SGID_FILES" | head -10 | tee -a "$LOG_FILE"
    fi
}

#=========================================
# CHECK 7: FILE PERMISSIONS
#=========================================
check_file_permissions() {
    echo -e "\n${BOLD}${MAGENTA}=== CHECKING FILE PERMISSIONS ===${NC}"
    echo "=== FILE PERMISSION CHECKS ===" >> "$REPORT_FILE"

    # Check /etc/passwd permissions
    log_info "Checking /etc/passwd permissions..."
    PASSWD_PERM=$(stat -c "%a" /etc/passwd 2>/dev/null)
    if [[ "$PASSWD_PERM" -le 644 ]]; then
        log_pass "/etc/passwd has correct permissions ($PASSWD_PERM)"
    else
        log_fail "/etc/passwd has insecure permissions ($PASSWD_PERM)"
    fi

    # Check /etc/shadow permissions
    log_info "Checking /etc/shadow permissions..."
    SHADOW_PERM=$(stat -c "%a" /etc/shadow 2>/dev/null)
    if [[ -n "$SHADOW_PERM" ]] && [[ "$SHADOW_PERM" -le 640 ]]; then
        log_pass "/etc/shadow has correct permissions ($SHADOW_PERM)"
    elif [[ -n "$SHADOW_PERM" ]]; then
        log_fail "/etc/shadow has insecure permissions ($SHADOW_PERM)"
    fi

    # Check /etc/group permissions
    log_info "Checking /etc/group permissions..."
    GROUP_PERM=$(stat -c "%a" /etc/group 2>/dev/null)
    if [[ "$GROUP_PERM" -le 644 ]]; then
        log_pass "/etc/group has correct permissions ($GROUP_PERM)"
    else
        log_fail "/etc/group has insecure permissions ($GROUP_PERM)"
    fi

    # Check world-writable files
    log_info "Checking for world-writable files..."
    WORLD_WRITABLE=$(find / -xdev -type f -perm -0002 ! -path "/proc/*" ! -path "/sys/*" 2>/dev/null | head -10)
    WW_COUNT=$(find / -xdev -type f -perm -0002 ! -path "/proc/*" ! -path "/sys/*" 2>/dev/null | wc -l)
    if [[ "$WW_COUNT" -eq 0 ]]; then
        log_pass "No world-writable files found"
    else
        log_warn "Found $WW_COUNT world-writable files"
    fi

    # Check for unowned files
    log_info "Checking for unowned files..."
    UNOWNED=$(find / -xdev \( -nouser -o -nogroup \) ! -path "/proc/*" ! -path "/sys/*" 2>/dev/null | head -10)
    UNOWNED_COUNT=$(find / -xdev \( -nouser -o -nogroup \) ! -path "/proc/*" ! -path "/sys/*" 2>/dev/null | wc -l)
    if [[ "$UNOWNED_COUNT" -eq 0 ]]; then
        log_pass "No unowned files found"
    else
        log_warn "Found $UNOWNED_COUNT unowned files"
    fi
}

#=========================================
# CHECK 8: RUNNING SERVICES
#=========================================
check_services() {
    echo -e "\n${BOLD}${MAGENTA}=== CHECKING RUNNING SERVICES ===${NC}"
    echo "=== SERVICE CHECKS ===" >> "$REPORT_FILE"

    log_info "Checking for potentially dangerous services..."

    # Check for Telnet
    if pgrep -x "telnetd" &> /dev/null || systemctl is-active telnetd &> /dev/null; then
        log_fail "Telnet server is running (insecure!)"
    else
        log_pass "Telnet server is not running"
    fi

    # Check for FTP
    if pgrep -x "vsftpd\|proftpd\|pure-ftpd" &> /dev/null; then
        log_warn "FTP server is running (use SFTP instead)"
    else
        log_pass "FTP server is not running"
    fi

    # Check for RSH/Rlogin
    if pgrep -x "rshd\|rlogind" &> /dev/null; then
        log_fail "RSH/Rlogin server is running (very insecure!)"
    else
        log_pass "RSH/Rlogin servers are not running"
    fi

    # Check for HTTP server
    if pgrep -x "apache2\|httpd\|nginx" &> /dev/null; then
        log_info "Web server is running"
    fi

    # Check for MySQL/MariaDB
    if pgrep -x "mysql\|mariadbd\|mysqld" &> /dev/null; then
        log_info "Database server is running"
    fi
}

#=========================================
# CHECK 9: SYSTEM UPDATES
#=========================================
check_updates() {
    echo -e "\n${BOLD}${MAGENTA}=== CHECKING SYSTEM UPDATES ===${NC}"
    echo "=== UPDATE CHECKS ===" >> "$REPORT_FILE"

    log_info "Checking for available updates..."

    if command -v apt &> /dev/null; then
        apt update -qq 2>/dev/null
        UPDATES=$(apt list --upgradable 2>/dev/null | grep -c "upgradable")
        if [[ "$UPDATES" -eq 0 ]]; then
            log_pass "System is up to date"
        elif [[ "$UPDATES" -le 5 ]]; then
            log_warn "$UPDATES updates available"
        else
            log_fail "$UPDATES updates available (system needs patching!)"
        fi
    elif command -v dnf &> /dev/null; then
        UPDATES=$(dnf check-update --quiet 2>/dev/null | grep -c "^")
        if [[ "$UPDATES" -eq 0 ]]; then
            log_pass "System is up to date"
        else
            log_warn "$UPDATES updates available"
        fi
    elif command -v yum &> /dev/null; then
        log_info "Yum package manager detected (check updates manually)"
    else
        log_warn "Unable to check for updates"
    fi

    # Check last update time
    log_info "Checking last system update..."
    if [[ -f /var/log/apt/history.log ]]; then
        LAST_UPDATE=$(grep -m1 "Start-Date:" /var/log/apt/history.log | cut -d: -f2-)
        log_info "Last update: $LAST_UPDATE"
    fi
}

#=========================================
# CHECK 10: LOGGING & AUDITING
#=========================================
check_logging() {
    echo -e "\n${BOLD}${MAGENTA}=== CHECKING LOGGING & AUDITING ===${NC}"
    echo "=== LOGGING CHECKS ===" >> "$REPORT_FILE"

    # Check syslog/rsyslog
    log_info "Checking syslog service..."
    if systemctl is-active rsyslog &> /dev/null; then
        log_pass "rsyslog service is running"
    elif systemctl is-active syslog-ng &> /dev/null; then
        log_pass "syslog-ng service is running"
    elif systemctl is-active systemd-journald &> /dev/null; then
        log_pass "systemd-journald is running"
    else
        log_warn "No logging service detected"
    fi

    # Check auditd
    log_info "Checking audit daemon..."
    if command -v auditd &> /dev/null; then
        if systemctl is-active auditd &> /dev/null; then
            log_pass "auditd is running"
        else
            log_warn "auditd is installed but not running"
        fi
    else
        log_warn "auditd is not installed"
    fi

    # Check log file sizes
    log_info "Checking log directory..."
    if [[ -d /var/log ]]; then
        LOG_SIZE=$(du -sh /var/log 2>/dev/null | awk '{print $1}')
        log_info "Log directory size: $LOG_SIZE"
    fi
}

#=========================================
# CHECK 11: CRON JOBS
#=========================================
check_cron_jobs() {
    echo -e "\n${BOLD}${MAGENTA}=== CHECKING CRON JOBS ===${NC}"
    echo "=== CRON JOB CHECKS ===" >> "$REPORT_FILE"

    log_info "Checking system cron jobs..."
    CRON_DIRS=("/etc/cron.daily" "/etc/cron.hourly" "/etc/cron.weekly" "/etc/cron.monthly")
    
    for dir in "${CRON_DIRS[@]}"; do
        if [[ -d "$dir" ]]; then
            CRON_COUNT=$(ls -1 "$dir" 2>/dev/null | wc -l)
            if [[ "$CRON_COUNT" -gt 0 ]]; then
                log_info "$dir: $CRON_COUNT jobs"
            fi
        fi
    done

    # Check user crontabs
    log_info "Checking user crontabs..."
    USER_CRONS=$(ls /var/spool/cron/crontabs/ 2>/dev/null)
    if [[ -n "$USER_CRONS" ]]; then
        log_info "Users with crontabs: $USER_CRONS"
    else
        log_pass "No user crontabs found"
    fi

    # Check cron permissions
    log_info "Checking cron access permissions..."
    if [[ -f /etc/cron.allow ]]; then
        log_pass "cron.allow exists (restricted access)"
    elif [[ -f /etc/cron.deny ]]; then
        log_warn "Using cron.deny (less secure than cron.allow)"
    else
        log_warn "Neither cron.allow nor cron.deny exists"
    fi
}

#=========================================
# CHECK 12: KERNEL SECURITY
#=========================================
check_kernel_security() {
    echo -e "\n${BOLD}${MAGENTA}=== CHECKING KERNEL SECURITY ===${NC}"
    echo "=== KERNEL SECURITY CHECKS ===" >> "$REPORT_FILE"

    # Check ASLR
    log_info "Checking ASLR (Address Space Layout Randomization)..."
    ASLR=$(cat /proc/sys/kernel/randomize_va_space 2>/dev/null)
    if [[ "$ASLR" == "2" ]]; then
        log_pass "ASLR is fully enabled"
    elif [[ "$ASLR" == "1" ]]; then
        log_warn "ASLR is partially enabled"
    else
        log_fail "ASLR is disabled!"
    fi

    # Check kernel exec shield
    log_info "Checking kernel exec-shield..."
    if [[ -f /proc/sys/kernel/exec-shield ]]; then
        EXEC_SHIELD=$(cat /proc/sys/kernel/exec-shield)
        if [[ "$EXEC_SHIELD" == "1" ]]; then
            log_pass "Exec-shield is enabled"
        else
            log_fail "Exec-shield is disabled"
        fi
    fi

    # Check kernel version
    log_info "Checking kernel version..."
    KERNEL_VER=$(uname -r)
    log_info "Running kernel: $KERNEL_VER"

    # Check for loaded kernel modules
    log_info "Checking loaded kernel modules..."
    MODULE_COUNT=$(lsmod 2>/dev/null | wc -l)
    log_info "Loaded kernel modules: $MODULE_COUNT"
}

#=========================================
# GENERATE REPORT
#=========================================
generate_report() {
    SCAN_END_TIME=$(date +"%Y-%m-%d %H:%M:%S")
    
    echo "" >> "$REPORT_FILE"
    echo "========================================" >> "$REPORT_FILE"
    echo "         SCAN SUMMARY" >> "$REPORT_FILE"
    echo "========================================" >> "$REPORT_FILE"
    echo "Scan Started:  $SCAN_START_TIME" >> "$REPORT_FILE"
    echo "Scan Finished: $SCAN_END_TIME" >> "$REPORT_FILE"
    echo "Total Checks:  $TOTAL_CHECKS" >> "$REPORT_FILE"
    echo "Passed:        $PASSED_CHECKS" >> "$REPORT_FILE"
    echo "Warnings:      $WARNINGS_FOUND" >> "$REPORT_FILE"
    echo "Failed:        $ISSUES_FOUND" >> "$REPORT_FILE"
    echo "========================================" >> "$REPORT_FILE"
    echo "Report saved to: $REPORT_FILE" >> "$REPORT_FILE"

    # Print summary to terminal
    echo ""
    echo -e "${CYAN}========================================${NC}"
    echo -e "${CYAN}           SCAN SUMMARY${NC}"
    echo -e "${CYAN}========================================${NC}"
    echo -e "${WHITE}Scan Started:  $SCAN_START_TIME${NC}"
    echo -e "${WHITE}Scan Finished: $SCAN_END_TIME${NC}"
    echo -e "${WHITE}Total Checks:  $TOTAL_CHECKS${NC}"
    echo -e "${GREEN}Passed:        $PASSED_CHECKS${NC}"
    echo -e "${YELLOW}Warnings:      $WARNINGS_FOUND${NC}"
    echo -e "${RED}Failed:        $ISSUES_FOUND${NC}"
    echo -e "${CYAN}========================================${NC}"
    echo -e "${WHITE}Report saved to: ${BOLD}$REPORT_FILE${NC}"
    echo ""
}

#=========================================
# DISPLAY HELP
#=========================================
display_help() {
    echo -e "${BOLD}${CYAN}Linux Security Scanner v$VERSION${NC}"
    echo ""
    echo -e "${WHITE}Usage: $0 [OPTIONS]${NC}"
    echo ""
    echo -e "${YELLOW}Options:${NC}"
    echo "  -h, --help      Display this help message"
    echo "  -v, --version   Display version information"
    echo "  -q, --quiet     Quiet mode (no colored output)"
    echo "  -o, --output    Specify output file"
    echo "  --users         Only check user accounts"
    echo "  --ssh           Only check SSH configuration"
    echo "  --network       Only check network/firewall"
    echo "  --files         Only check file permissions"
    echo "  --all           Run all checks (default)"
    echo ""
    echo -e "${YELLOW}Examples:${NC}"
    echo "  sudo $0                  # Run all checks"
    echo "  sudo $0 --ssh            # Check SSH only"
    echo "  sudo $0 -o report.txt    # Custom output file"
    echo ""
    echo -e "${YELLOW}Note: Run with sudo for complete scan${NC}"
}

#=========================================
# DISPLAY VERSION
#=========================================
display_version() {
    echo "security_scanner.sh version $VERSION"
    echo "Copyright (C) $(date +%Y) YourName"
    echo "License: MIT"
}

#=========================================
# MAIN FUNCTION
#=========================================
main() {
    # Parse command line arguments
    case "${1:-}" in
        -h|--help)
            display_help
            exit 0
            ;;
        -v|--version)
            display_version
            exit 0
            ;;
        --users)
            init_scanner
            check_user_accounts
            check_password_policy
            generate_report
            exit 0
            ;;
        --ssh)
            init_scanner
            check_ssh_config
            generate_report
            exit 0
            ;;
        --network)
            init_scanner
            check_firewall
            check_open_ports
            generate_report
            exit 0
            ;;
        --files)
            init_scanner
            check_file_permissions
            check_suid_sgid
            generate_report
            exit 0
            ;;
        -o|--output)
            REPORT_FILE="${2:-security_report.txt}"
            shift 2
            ;;
        -q|--quiet)
            RED=''; GREEN=''; YELLOW=''; BLUE=''; MAGENTA=''; CYAN=''; WHITE=''; NC=''; BOLD=''
            shift
            ;;
    esac

    # Initialize and run all checks
    init_scanner
    check_user_accounts
    check_password_policy
    check_ssh_config
    check_firewall
    check_open_ports
    check_suid_sgid
    check_file_permissions
    check_services
    check_updates
    check_logging
    check_cron_jobs
    check_kernel_security
    generate_report

    # Exit with appropriate code
    if [[ "$ISSUES_FOUND" -gt 0 ]]; then
        exit 1
    elif [[ "$WARNINGS_FOUND" -gt 0 ]]; then
        exit 2
    else
        exit 0
    fi
}

#=========================================
# SCRIPT ENTRY POINT
#=========================================
main "$@"
